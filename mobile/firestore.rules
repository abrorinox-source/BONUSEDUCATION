rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userDoc() { return signedIn() ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data : null; }
    function teacher() { return signedIn() && userDoc().role in ['teacher', 'admin']; }
    function self(uid) { return signedIn() && request.auth.uid == uid; }

    match /users/{uid} {
      allow read: if self(uid) || teacher();
      allow create: if self(uid);
      allow update: if self(uid) || teacher();
      allow delete: if teacher();
    }
    match /groups/{groupId} {
      allow read: if signedIn();
      allow create, update, delete: if teacher();
      match /columns/{columnId} { allow read: if signedIn(); allow create, update, delete: if teacher(); }
      match /students/{studentId} { allow read: if signedIn(); allow create, update, delete: if teacher(); }
    }
    match /transactions/{id} {
      allow read: if signedIn();
      allow create, update, delete: if false;
    }
    match /transferRequests/{id} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if teacher();
      allow delete: if false;
    }
    match /settings/{id} { allow read: if signedIn(); allow write: if teacher(); }
    match /{document=**} { allow read, write: if false; }
  }
}
